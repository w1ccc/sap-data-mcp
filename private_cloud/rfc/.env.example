# RFC Golden Path credentials. Non-sensitive RFC fields belong in config/SAP_SYSTEM_INFO.
SAP_USERNAME=
SAP_PASSWORD=

# Legacy test_sap_connection HTTPS Tool only; not used by SAPRFCConnector.
# SAP_CA_BUNDLE is relative to the project folder, e.g. config/certs/<your-ca>.crt
SAP_BASE_URL=
SAP_CLIENT=
SAP_LANGUAGE=EN
SAP_VERIFY_SSL=true
SAP_CA_BUNDLE=

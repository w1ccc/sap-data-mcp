# Copy to private_cloud/odata/.env OR public_cloud/api/.env, then configure that route.
SAP_API_BASE_URL=
SAP_API_AUTH=basic
SAP_API_USERNAME=
SAP_API_PASSWORD=
SAP_API_CLIENT=
SAP_API_LANGUAGE=EN
# Optional PEM CA bundle, relative to that provider's directory. TLS verification stays enabled.
SAP_API_CA_BUNDLE=
# For SAP_API_AUTH=oauth: OAuth 2.0 client credentials using HTTP Basic client authentication.
SAP_API_TOKEN_URL=
SAP_API_CLIENT_ID=
SAP_API_CLIENT_SECRET=
SAP_API_SCOPE=
